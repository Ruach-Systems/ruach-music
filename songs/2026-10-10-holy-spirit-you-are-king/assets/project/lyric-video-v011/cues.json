[
  {
    "text": "Holy Spirit, in the morning,",
    "vocal_start": 13.35,
    "vocal_end": 16.88,
    "start": 13.17,
    "end": 17.16
  },
  {
    "text": "When the fields are washed in gold,",
    "vocal_start": 17.34,
    "vocal_end": 20.12,
    "start": 17.16,
    "end": 20.9
  },
  {
    "text": "I grow quiet in Your presence,",
    "vocal_start": 21.08,
    "vocal_end": 23.76,
    "start": 20.9,
    "end": 24.38
  },
  {
    "text": "Let Your will take full control.",
    "vocal_start": 24.56,
    "vocal_end": 27.04,
    "start": 24.38,
    "end": 27.04
  },
  {
    "text": "You are nearer than my breathing,",
    "vocal_start": 27.04,
    "vocal_end": 30.6,
    "start": 27.04,
    "end": 30.6
  },
  {
    "text": "Yet Your throne is over all;",
    "vocal_start": 30.6,
    "vocal_end": 34.14,
    "start": 30.6,
    "end": 34.58
  },
  {
    "text": "With a heart that loves Your leading,",
    "vocal_start": 34.76,
    "vocal_end": 37.46,
    "start": 34.58,
    "end": 38.08
  },
  {
    "text": "I will answer when You call.",
    "vocal_start": 38.26,
    "vocal_end": 40.78,
    "start": 38.08,
    "end": 42.56
  },
  {
    "text": "Holy Spirit, You are King,",
    "vocal_start": 42.74,
    "vocal_end": 45.78,
    "start": 42.56,
    "end": 46.4
  },
  {
    "text": "Every breath is Yours to lead.",
    "vocal_start": 46.58,
    "vocal_end": 49.2,
    "start": 46.4,
    "end": 49.2
  },
  {
    "text": "You're the Father. You're the Son.",
    "vocal_start": 49.2,
    "vocal_end": 52.84,
    "start": 49.2,
    "end": 53.22
  },
  {
    "text": "You are King.",
    "vocal_start": 53.4,
    "vocal_end": 54.46,
    "start": 53.22,
    "end": 55.0
  },
  {
    "text": "You are one, and all I need.",
    "vocal_start": 55.18,
    "vocal_end": 57.78,
    "start": 55.0,
    "end": 58.3
  },
  {
    "text": "Yours the power,",
    "vocal_start": 58.48,
    "vocal_end": 59.72,
    "start": 58.3,
    "end": 60.14
  },
  {
    "text": "Yours the Kingdom,",
    "vocal_start": 60.32,
    "vocal_end": 61.44,
    "start": 60.14,
    "end": 61.88
  },
  {
    "text": "Yours the right to rule in me.",
    "vocal_start": 62.06,
    "vocal_end": 64.92,
    "start": 61.88,
    "end": 65.38
  },
  {
    "text": "Let my love become obedience,",
    "vocal_start": 65.56,
    "vocal_end": 68.36,
    "start": 65.38,
    "end": 68.8
  },
  {
    "text": "Let my life be Your decree.",
    "vocal_start": 68.98,
    "vocal_end": 71.3,
    "start": 68.8,
    "end": 72.55
  },
  {
    "text": "When Your whisper",
    "vocal_start": 76.92,
    "vocal_end": 78.58,
    "start": 76.74,
    "end": 78.58
  },
  {
    "text": "meets my wanting,",
    "vocal_start": 78.58,
    "vocal_end": 80.32,
    "start": 78.58,
    "end": 80.52
  },
  {
    "text": "Teach my heart to choose Your way.",
    "vocal_start": 80.7,
    "vocal_end": 83.64,
    "start": 80.52,
    "end": 84.0
  },
  {
    "text": "Let my yes be more than singing,",
    "vocal_start": 84.18,
    "vocal_end": 87.14,
    "start": 84.0,
    "end": 87.58
  },
  {
    "text": "Let it live through every day.",
    "vocal_start": 87.76,
    "vocal_end": 90.52,
    "start": 87.58,
    "end": 90.88
  },
  {
    "text": "Not from fear, but love that listens,",
    "vocal_start": 91.06,
    "vocal_end": 93.98,
    "start": 90.88,
    "end": 94.6
  },
  {
    "text": "I lay down my claim to reign;",
    "vocal_start": 94.78,
    "vocal_end": 97.4,
    "start": 94.6,
    "end": 97.4
  },
  {
    "text": "You command with perfect wisdom,",
    "vocal_start": 97.4,
    "vocal_end": 101.02,
    "start": 97.4,
    "end": 101.02
  },
  {
    "text": "I delight to bear Your name.",
    "vocal_start": 101.14,
    "vocal_end": 104.2,
    "start": 101.02,
    "end": 106.08
  },
  {
    "text": "Holy Spirit, You are King,",
    "vocal_start": 106.26,
    "vocal_end": 109.24,
    "start": 106.08,
    "end": 109.84
