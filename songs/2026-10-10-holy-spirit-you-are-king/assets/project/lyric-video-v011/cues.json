    "start": 128.72,
    "end": 132.24
  },
  {
    "text": "Let my life be Your decree.",
    "vocal_start": 132.42,
    "vocal_end": 134.74,
    "start": 132.24,
    "end": 137.12
  },
  {
    "text": "No power stands above You,",
    "vocal_start": 137.3,
    "vocal_end": 140.56,
    "start": 137.12,
    "end": 140.8
  },
  {
    "text": "No throne can take Your place.",
    "vocal_start": 140.98,
    "vocal_end": 143.64,
    "start": 140.8,
    "end": 143.64
  },
  {
    "text": "Your authority is endless,",
    "vocal_start": 143.64,
    "vocal_end": 147.26,
    "start": 143.64,
    "end": 147.5
  },
  {
    "text": "And Your nearness fills my days.",
    "vocal_start": 147.68,
    "vocal_end": 150.96,
    "start": 147.5,
    "end": 151.2
  },
  {
    "text": "In the quiet, in the working,",
    "vocal_start": 151.38,
    "vocal_end": 154.02,
    "start": 151.2,
    "end": 154.46
  },
  {
    "text": "Keep my heart close to Your own.",
    "vocal_start": 154.64,
    "vocal_end": 157.48,
    "start": 154.46,
    "end": 158.08
  },
  {
    "text": "Every thought and every longing,",
    "vocal_start": 158.26,
    "vocal_end": 160.86,
    "start": 158.08,
    "end": 161.3
  },
  {
    "text": "Make them subject to Your throne.",
    "vocal_start": 161.48,
    "vocal_end": 164.42,
    "start": 161.3,
    "end": 166.14
  },
